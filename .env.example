# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in your hosting provider (e.g. Vercel)
# for production. Never commit the real values.

# Resend (https://resend.com) API key used to send Contact / Volunteer /
# Partner form submissions by email. Sign up (free tier is enough to start),
# create an API key, and paste it here.
RESEND_API_KEY=

# The inbox that should receive form submissions. This is the trust's
# "admin access" for now — whoever has access to this inbox can see
# submitted names/emails/messages. Enable 2FA on it.
INQUIRY_TO_EMAIL=

# Optional: the "from" address shown on the email Resend sends. Until you
# verify your own domain in Resend, leave this unset — it will default to
# Resend's shared onboarding@resend.dev sender, which works without any
# domain setup but is best replaced once you have a verified domain
# (e.g. "Panch Pran Vikas Trust <noreply@panchpranvikastrust.org>").
INQUIRY_FROM_EMAIL=

# Optional: route a specific form's submissions to a different inbox than
# INQUIRY_TO_EMAIL, e.g. send Partner/CSR enquiries to a different person.
# Leave unset to have all three forms use INQUIRY_TO_EMAIL.
INQUIRY_TO_EMAIL_CONTACT=
INQUIRY_TO_EMAIL_VOLUNTEER=
INQUIRY_TO_EMAIL_PARTNER=

# Optional but recommended: Cloudflare Turnstile (free) CAPTCHA on the three
# forms. Without these, the forms rely only on a honeypot field, a
# minimum-fill-time check, and a per-IP rate limit — real protection, but a
# determined scripted attacker can still get through. Get a free site key +
# secret key at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: a Slack or Discord "incoming webhook" URL. If set, the backend
# posts a message there whenever a form submission genuinely fails to send
# (not on routine validation errors or spam rejections), so you find out
# before a donor/volunteer notices nobody replied.
OPS_ALERT_WEBHOOK_URL=
